<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="?attr/colorOnPrimary"
        app:title="@string/group_management_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/action_back"/>

    <!-- Lista członków grupy -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/membersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:paddingTop="8dp"/>

    <!-- Liczba członków -->
    <TextView
        android:id="@+id/memberCountTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"/>

    <!-- Przycisk dodania nowych członków -->
    <Button
        android:id="@+id/addMembersButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/add_members"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6200EE"
        android:layout_marginTop="8dp"/>

    <!-- Przycisk opuszczenia grupy -->
    <Button
        android:id="@+id/leaveGroupButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/leave_group"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B00020"
        android:layout_marginTop="8dp"/>

    <!-- Usunięcie grupy (tylko admin) -->
    <Button
        android:id="@+id/deleteGroupButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/delete_group"
        android:textColor="#B00020"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>
</LinearLayout>
