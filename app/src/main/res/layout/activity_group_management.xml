<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#6200EE"
        android:titleTextColor="#FFFFFF"
        android:title="Zarządzanie grupą"/>

    <!-- Lista członków grupy -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/membersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:paddingTop="8dp"/>

    <!-- Licznik lub info o zaznaczonych użytkownikach (opcjonalnie) -->
    <TextView
        android:id="@+id/tv_selected_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#000000"
        android:padding="8dp"/>

    <!-- Przycisk dodania nowych członków -->
    <Button
        android:id="@+id/addMembersButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Dodaj członków"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6200EE"
        android:layout_marginTop="8dp"/>

    <!-- Przycisk opuszczenia grupy -->
    <Button
        android:id="@+id/leaveGroupButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Opuść grupę"
        android:textColor="#FFFFFF"
        android:backgroundTint="#B00020"
        android:layout_marginTop="8dp"/>
</LinearLayout>
