// Reguły bezpieczeństwa Firestore. Aplikacja łączy się z bazą bezpośrednio z telefonu,
// więc to tutaj, a nie w kodzie aplikacji, naprawdę decyduje się, kto co może odczytać i zmienić.
// Domyślnie wszystko jest zabronione - dostęp daje tylko jawne `allow`.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funkcje pomocnicze ---

    function signedIn() {
      return request.auth != null;
    }

    // UID zalogowanego użytkownika z Firebase Auth
    function uid() {
      return request.auth.uid;
    }

    // Dokument czatu - potrzebny przy wiadomościach, bo to w czacie jest lista uczestników.
    // Każde get() liczy się jako dodatkowy odczyt z bazy.
    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isParticipant(chatId) {
      return signedIn() && uid() in chatData(chatId).participants;
    }

    // Czy zapis zmienia wyłącznie podane pola (pozostałe muszą zostać bez zmian)
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Lista `readBy` może tylko urosnąć, i to wyłącznie o bieżącego użytkownika
    function readByAddsOnlySelf() {
      let before = resource.data.get('readBy', []).toSet();
      let after = request.resource.data.get('readBy', []).toSet();
      return after.hasAll(before) && after.difference(before).hasOnly([uid()]);
    }

    // get() z wartością domyślną - starsze dokumenty mogą nie mieć pola isGroup
    function isGroup(data) {
      return data.get('isGroup', false) == true;
    }

    // --- Kolekcje ---

    // Profile użytkowników: każdy zalogowany może czytać, ale zapisywać tylko własny dokument.
    match /users/{userId} {
      allow read: if signedIn();
      // Pole id w dokumencie musi zgadzać się z jego identyfikatorem (UID)
      allow create, update: if signedIn() && uid() == userId && request.resource.data.id == userId;
      allow delete: if false;
    }

    // Czaty prywatne i grupy
    match /chats/{chatId} {
      // Czat widzą tylko jego uczestnicy
      allow read: if signedIn() && uid() in resource.data.participants;

      // Twórca musi być uczestnikiem; czat prywatny ma dokładnie 2 osoby,
      // a w grupie twórca zostaje jej adminem
      allow create: if signedIn()
        && uid() in request.resource.data.participants
        && (
          (!isGroup(request.resource.data) && request.resource.data.participants.size() == 2)
          || (isGroup(request.resource.data) && request.resource.data.groupAdmin == uid())
        );

      allow update: if signedIn() && uid() in resource.data.participants && (
        // Każdy uczestnik aktualizuje podgląd ostatniej wiadomości, ale tylko jako jej nadawca
        (changedOnly(['lastMessage', 'lastMessageTime'])
          && request.resource.data.lastMessage.senderId == uid())
        // Admin grupy może zmieniać skład, nazwę i admina
        || (isGroup(resource.data) && isGroup(request.resource.data) && resource.data.groupAdmin == uid())
        // Zwykły członek może tylko opuścić grupę, usuwając samego siebie
        || (isGroup(resource.data)
            && changedOnly(['participants'])
            && request.resource.data.participants.toSet()
               == resource.data.participants.toSet().difference([uid()].toSet()))
      );

      // Usunąć można tylko grupę i tylko jako admin (wiadomości usuwa potem Cloud Function)
      allow delete: if signedIn() && isGroup(resource.data) && resource.data.groupAdmin == uid();
    }

    // Wiadomości wszystkich czatów w jednej kolekcji; o dostępie decyduje czat z pola chatId
    match /messages/{messageId} {
      allow read: if isParticipant(resource.data.chatId);

      // Nie da się wysłać wiadomości w czyimś imieniu ani do czatu, w którym się nie jest
      allow create: if signedIn()
        && request.resource.data.senderId == uid()
        && isParticipant(request.resource.data.chatId)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000 // limit długości, żeby nie zapychać bazy
        // Nowa wiadomość nie może udawać już dostarczonej ani przeczytanej
        && request.resource.data.get('seen', false) == false
        && !(request.resource.data.get('status', '') in ['delivered', 'read'])
        && request.resource.data.get('readBy', []).size() == 0
        && request.resource.data.get('recipients', []) is list;

      // Odbiorcy mogą zmieniać wyłącznie status dostarczenia/odczytu i dopisać siebie do readBy
      allow update: if isParticipant(resource.data.chatId)
        && resource.data.senderId != uid()
        && changedOnly(['status', 'seen', 'deliveredAt', 'readAt', 'readBy'])
        && request.resource.data.status in ['delivered', 'read']
        && readByAddsOnlySelf();

      // Usunąć można tylko własną wiadomość
      allow delete: if signedIn() && resource.data.senderId == uid();
    }
  }
}
